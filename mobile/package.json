{
  "name": "@dustnote/mobile",
  "version": "2.5.29",
  "private": true,
  "description": "DustNote Android (React Native)",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest --passWithNoTests",
    "lint": "eslint .",
    "build:android": "node scripts/build-android.js assembleRelease",
    "build:android-bundle": "node scripts/build-android.js bundleRelease",
    "build:aab": "node scripts/build-android.js bundleRelease",
    "build:ios": "cd ios && xcodebuild -workspace DustNote.xcworkspace -scheme DustNote -configuration Release -archivePath ./build/DustNote.xcarchive archive",
    "build:ios-sim": "xcodebuild -workspace ios/DustNote.xcworkspace -scheme DustNote -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dustnote/client-core": "workspace:*",
    "@dustnote/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-clipboard/clipboard": "^1.14.0",
    "@react-native-voice/voice": "^3.2.4",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "base64-js": "^1.5.1",
    "fast-text-encoding": "^1.0.6",
    "i18next": "^23.11.5",
    "react": "18.2.0",
    "react-i18next": "^14.1.2",
    "react-native": "0.74.1",
    "react-native-biometrics": "^3.0.1",
    "react-native-document-picker": "^9.3.1",
    "react-native-fs": "^2.20.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-keychain": "^8.2.0",
    "react-native-quick-crypto": "^0.7.7",
    "react-native-safe-area-context": "^4.10.1",
    "react-native-screens": "^3.31.1",
    "react-native-share": "^12.3.1",
    "react-native-svg": "^15.8.0",
    "react-native-vector-icons": "^10.1.0",
    "react-native-webview": "^13.8.6",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.29.7",
    "@react-native/babel-preset": "0.74.83",
    "@react-native/eslint-config": "0.74.83",
    "@react-native/metro-config": "0.74.83",
    "@react-native/typescript-config": "0.74.83",
    "@types/react": "^18.2.6",
    "@types/react-native-sqlite-storage": "^6.0.5",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.2.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
