{
  "name": "@dustnote/web",
  "version": "2.5.4",
  "private": true,
  "description": "DustNote Web 客户端",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@dustnote/client-core": "workspace:*",
    "@dustnote/shared": "workspace:*",
    "@sentry/react": "^10.68.0",
    "dompurify": "^3.1.0",
    "i18next": "^23.11.5",
    "idb-keyval": "^6.2.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "marked": "^13.0.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "^14.1.2",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.0",
    "vite": "^5.3.1",
    "vitest": "^1.6.0"
  }
}
