# 复制为 .env.monitoring 并填值（该文件已 gitignore，含推送凭据）
#
# NTFY_TOPIC：手机 ntfy 客户端订阅的随机难猜主题名（泄露=别人能给你发通知，
# 生成建议：openssl rand -hex 12）。NTFY_SERVER 可换自建实例。
NTFY_TOPIC=change-me-random-string
NTFY_SERVER=https://ntfy.sh

# 抓取主栈 /metrics 的 token 文件路径（纯文本单行，内容=主栈 METRICS_TOKEN；
# 生成见 README 步骤 2）。一般无需改动。
# METRICS_TOKEN_FILE=/opt/metrics-token.txt