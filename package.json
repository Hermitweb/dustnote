{
  "name": "dustnote",
  "version": "2.5.23",
  "private": true,
  "description": "DustNote · 尘心笔记 - 极简跨端个人笔记系统",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0 <25.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "dev:server": "pnpm --filter @dustnote/server dev",
    "dev:web": "pnpm --filter @dustnote/web dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter @dustnote/web build",
    "build:server": "pnpm --filter @dustnote/server build",
    "build:desktop": "pnpm --filter @dustnote/desktop build",
    "build:miniprogram": "pnpm --filter @dustnote/miniprogram build:weapp",
    "build:h5": "pnpm --filter @dustnote/miniprogram build:h5",
    "build:android": "pnpm --filter @dustnote/mobile build:android",
    "build:ios": "pnpm --filter @dustnote/mobile build:ios",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "pnpm -r exec rm -rf dist build .turbo node_modules/.cache",
    "audit": "pnpm audit --prod",
    "prepare": "node -e \"try{require('husky').install()}catch(_){}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.2.0",
    "turbo": "^2.10.12",
    "typescript": "^5.4.0"
  },
  "pnpm": {
    "overrides": {
      "lodash-es": "^4.18.1",
      "fast-uri": "^3.1.5",
      "brace-expansion": "^1.1.18",
      "vm2@3.11.5": "^3.11.6",
      "minimatch@9.0.3": "~9.0.9",
      "nanoid@3.3.15": "~3.3.18",
      "postcss@8.5.15": "~8.5.26",
      "postcss@7.0.39": "~8.5.26",
      "autoprefixer@9.8.8": "~10.4.21",
      "js-yaml@3.15.0": "~3.15.1",
      "js-yaml@4.3.0": "~4.3.1",
      "svgo@2.8.2": "~2.8.3",
      "form-data@2.3.3": "~2.5.6",
      "serialize-javascript@6.0.2": "~7.0.3",
      "tmp@0.0.33": "~0.2.6",
      "http-cache-semantics@3.8.1": "~4.1.1",
      "adm-zip@0.4.16": "~0.6.0",
      "glob@10.2.6": "~10.5.0",
      "body-parser@1.20.5": "~1.20.6",
      "qs@6.5.5": "~6.15.3",
      "esbuild@0.19.12": "~0.25.12",
      "esbuild@0.14.54": "~0.25.12",
      "webpack-dev-server@<5.2.6": "^5.2.6",
      "fast-xml-parser@<5.7.0": "^5.7.0",
      "uuid@8.3.2": "^11.1.1"
    }
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7"
  }
}
