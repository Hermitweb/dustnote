{
  "default": {
    "identifier": "default",
    "description": "Default capability for DustNote desktop app",
    "local": true,
    "windows": ["main"],
    "permissions": [
      "core:default",
      "core:window:default",
      "core:window:allow-set-title",
      "core:window:allow-set-focus",
      "core:window:allow-show",
      "core:window:allow-hide",
      "core:tray:default",
      "core:menu:default",
      "core:app:default",
      "core:event:default",
      "core:path:default",
      "autostart:default",
      "notification:default",
      "store:default",
      "os:default",
      "global-shortcut:default"
    ]
  }
}
