# 服务端环境变量模板（实际使用复制为 .env）

# ========== 基础 ==========
NODE_ENV=development
PORT=3210
LOG_LEVEL=info

# ========== 数据库 ==========
DB_PATH=./data/dustnote.db

# ========== CORS ==========
WEB_ORIGIN=http://localhost:5173

# ========== 服务端版本（必须与 package.json 一致）==========
SERVER_VERSION=2.5.29

# ========== 客户端版本策略（详见 update-strategy.md §2.3）==========
MIN_CLIENT_VERSION=2.0.2
RECOMMENDED_CLIENT_VERSION=2.5.29
# 强制升级版本（空 = 不强制）
FORCE_UPDATE_VERSION=

# ========== EOL ==========
# 旧 MAJOR 版本客户端 EOL 日期
EOL_DATE_FOR_V0=

# ========== 必填（生产环境）==========
# 生产环境强制要求：openssl rand -base64 48
# 禁止使用下方占位值（config-validate.ts 会拒绝形如 change-me/your-secret 的弱密钥）
JWT_SECRET=

# ========== JWT 非对称签名（EdDSA / Ed25519，可选，留空回退 HS256）==========
# 生成：node server/scripts/gen-jwt-keys.js
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ========== 反代层数 ==========
# nginx/CDN 在前面时设 1（生产环境 config-validate 会拒绝 TRUST_PROXY=0）。
# 限流依赖它取真实客户端 IP。
TRUST_PROXY=1

# ========== 自动备份 ==========
# SQLite 自动备份目录（容器部署建议挂载持久卷）
BACKUP_DIR=./backups
# 备份保留份数（按日期滚动）
BACKUP_RETENTION=30

# ========== Sentry 错误监控（可选，留空=禁用）==========
# 自托管部署可不填；填写后在 Sentry 控制台聚合服务端未捕获异常
SENTRY_DSN=
