# 服务端环境变量模板（实际使用复制为 .env）

# ========== 基础 ==========
NODE_ENV=development
PORT=3210
LOG_LEVEL=info

# ========== 数据库 ==========
DB_PATH=./server/data/mintnote.db

# ========== CORS ==========
WEB_ORIGIN=http://localhost:5173

# ========== 服务端版本（必须与 package.json 一致）==========
SERVER_VERSION=0.1.0

# ========== 客户端版本策略（详见 update-strategy.md §2.3）==========
MIN_CLIENT_VERSION=0.1.0
RECOMMENDED_CLIENT_VERSION=0.1.0
# 强制升级版本（空 = 不强制）
FORCE_UPDATE_VERSION=

# ========== EOL ==========
# 旧 MAJOR 版本客户端 EOL 日期
EOL_DATE_FOR_V0=

# ========== 占位（未来）==========
JWT_SECRET=change-me-to-a-32-char-random-string
