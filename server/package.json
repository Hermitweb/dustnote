{
  "name": "@dustnote/server",
  "version": "2.5.21",
  "private": true,
  "description": "DustNote 后端服务",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo data/*.db*"
  },
  "dependencies": {
    "@dustnote/shared": "workspace:*",
    "@sentry/node": "^10.68.0",
    "@simplewebauthn/server": "^13.3.3",
    "better-sqlite3": "^12.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "pino": "^9.2.0",
    "pino-http": "^10.1.0",
    "ws": "^8.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "@types/ws": "^8.5.10",
    "pino-pretty": "^11.0.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.6"
  }
}
