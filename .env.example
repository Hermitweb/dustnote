# DustNote 生产环境变量
# 复制为 .env 后修改

# 宿主机端口（容器内固定监听 3210，此处仅用于宿主机端口映射）
# docker-compose.yml: '${PORT:-8080}:3210'
PORT=8080

# 前端域名（CORS 白名单，生产必须改为实际访问域名）
WEB_ORIGIN=https://dustnote.your-domain.com

# 服务版本（必须与 package.json 一致）
SERVER_VERSION=2.0.3

# 客户端版本策略（详见 update-strategy.md §2.3）
MIN_CLIENT_VERSION=2.0.2
RECOMMENDED_CLIENT_VERSION=2.0.3
# 强制升级版本（空 = 不强制）
FORCE_UPDATE_VERSION=
# 旧 MAJOR 版本客户端 EOL 日期
EOL_DATE_FOR_V0=

# JWT 签名密钥（生产必须修改！建议 openssl rand -hex 32）
JWT_SECRET=change-me-to-a-32-char-random-string

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# 仅 TLS 模式：Caddy 反向代理域名
# DOMAIN=notes.your-domain.com
