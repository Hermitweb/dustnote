# DustNote 生产环境变量
# 复制为 .env 后修改

# 宿主机端口（容器内固定监听 3210，此处仅用于宿主机端口映射）
# docker-compose.yml: '${PORT:-8080}:3210'
# 宿主发布地址。默认 127.0.0.1：公网流量一律走前置反代（TLS/HSTS/强制跳转在那层收口），
# 8080 不再直接对外 —— 那是 R1「强制 HTTPS」收不干净的那条旁路（2026-10-02 收口，
# 见 docs/roadmap.md）。同机反代与本机访问不受影响；确实要跨机明文直连的部署才改 0.0.0.0。
PORT_BIND=127.0.0.1
PORT=8080

# 前端域名（CORS 白名单，生产必须改为实际访问域名）
WEB_ORIGIN=https://dustnote.your-domain.com

# 服务端地址登记的运维覆盖（可选）：设置后 GET /api/v1/config/server-endpoint
# 永远返回该值——服务器迁移时在此一键改指,小程序新设备引导后即用新地址；
# 留空则返回首次激活的设备登记的地址（先到先得）。
# SERVER_PUBLIC_URL=https://dustnote.your-domain.com

# 强制升级响应里的下载地址（LIFE-008/009）；留空回退 WEB_ORIGIN（产物自托管在
# 同源 /downloads/ 下时留空即可）。曾硬编码无服务的 dustnote.app——勿再引入。
# DOWNLOAD_PAGE_URL=

# 服务版本（必须与 package.json 一致）
SERVER_VERSION=2.5.52

# 客户端版本策略（详见 update-strategy.md §2.3）
MIN_CLIENT_VERSION=2.0.2
RECOMMENDED_CLIENT_VERSION=2.5.52
# 强制升级版本（空 = 不强制）
FORCE_UPDATE_VERSION=
# 旧 MAJOR 版本客户端 EOL 日期
EOL_DATE_FOR_V0=

# 【必填】JWT 签名密钥，≥32 字符随机串。未设置时 docker compose 会直接拒绝启动。
# 生成：openssl rand -base64 48
# 注意：配置下方 JWT_PRIVATE_KEY/JWT_PUBLIC_KEY 后，将优先使用 EdDSA（非对称签名），
# 此 JWT_SECRET 仅作为未配置非对称密钥时的回退（HS256），以及迁移期间验签旧 token。
JWT_SECRET=

# 【推荐】JWT 非对称签名（EdDSA / Ed25519）密钥对。
# 配置后优先使用 EdDSA 替代 HS256：私钥仅在服务端，泄露风险更低；公钥可离线验签。
# 生成：node server/scripts/gen-jwt-keys.js
# 留空时回退到 JWT_SECRET (HS256)。
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# 反代层数（nginx 在前面时设 1）。限流依赖它取真实客户端 IP。
TRUST_PROXY=1

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# 仅 TLS 模式：Caddy 反向代理域名
# DOMAIN=notes.your-domain.com

# 备份加密口令（可选，建议设置）：备份含 users.totp_secret / wrapped_master_key
# 等敏感材料。设置后每日备份以 AES-256-GCM 加密为 db-*.sqlite.enc；
# 恢复：node dist/scripts/backup.js --decrypt <备份.enc> <输出.sqlite>
BACKUP_ENCRYPTION_KEY=

# ========== Prometheus 指标（审计 LIFE-009，默认关闭）==========
# 开启后 GET /metrics 暴露 Prometheus 文本格式指标（HTTP 耗时直方图、
# 5xx 计数、WS 活跃连接、认证锁定、备份结果、库文件大小 + 进程默认指标）
# 建议同时配置反代仅允许内网/监控器访问
# METRICS_ENABLED=true
# 抓取端点 Bearer 保护（留空 = 不鉴权，仅依赖网络层隔离）
# METRICS_TOKEN=
# 灰度通道版本与切流比例（update-manifest；默认仍为占位值，接入灰度时配置）
# UPDATE_CHANNEL_BETA=
# UPDATE_CHANNEL_CANARY=
# UPDATE_CHANNEL_NIGHTLY=
# BETA_TRAFFIC_RATIO=0.01

# ========== 存储路径（容器内路径；宿主机映射见 docker-compose.yml 的 volumes）==========
# SQLite 主文件。compose 里已写死 /app/server/data/dustnote.db，
# 裸进程部署才需要改。留空回退 ./data/dustnote.db。
# DB_PATH=/app/server/data/dustnote.db

# 每日自动备份目录。留空回退 <cwd>/backups；compose 里已写死 /app/server/backups
# 并挂了卷——改这里要同步确认卷还在，否则备份会写到容器可写层，重建即丢。
# BACKUP_DIR=/app/server/backups

# 备份保留份数（留空 = 30）
# BACKUP_RETENTION=30

# 更新产物目录：应用内更新与 /download 页读这里的 *.sha256 与安装包。
# 留空回退 /app/web-dist/downloads（与 nginx 的 /downloads/ 前缀同源）。
# DOWNLOADS_DIR=/app/web-dist/downloads

# ========== 安全开关 ==========
# 字段级加密（TOTP 密钥等敏感列）的独立 KEK。留空时回退用 JWT_SECRET 经
# HKDF 派生（info 与 JWT 签名隔离，不共用同一字节），既有部署无需新增变量
# 即可平滑启用；但**建议单独设置**：这样「DB 泄露但 .env 未泄露」的威胁模型
# 才成立，且将来可只轮换本键而不失效 JWT。生成：openssl rand -base64 48
# FIELD_ENCRYPTION_KEY=

# 刷新 cookie 的 Secure 标志。默认按 NODE_ENV 推断（生产 = true）。
# 非 HTTPS 部署（裸 IP / 局域网 HTTP）必须设为 false，否则浏览器会丢弃
# Secure cookie 导致 refresh 静默失效——症状是「登录一会儿就掉线」。
# 设 false 需自行承担明文传输风险，且 R1 强制 HTTPS 落地后应改回。
# COOKIE_SECURE=false

# 服务端错误上报 DSN（自建，与安卓/Web 同契约：只回摘要、绝不含笔记正文）。
# 留空 = 关闭服务端上报。注意这是服务端侧，客户端的开关在设置页里。
# SENTRY_DSN=

# ========== 构建期镜像源（只在自建镜像时需要，运行期无效）==========
# 中国网络自建时可填 dl.aliyun.com 之类的 apk 镜像与 npm registry；
# 两者都以 ARG 形式进 Dockerfile，因此只对 docker build 生效。
# APK_MIRROR=dl-cdn.alpinelinux.org
# NPM_REGISTRY=
