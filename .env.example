# DustNote 生产环境变量
# 复制为 .env 后修改

# 宿主机端口（容器内固定监听 3210，此处仅用于宿主机端口映射）
# docker-compose.yml: '${PORT:-8080}:3210'
PORT=8080

# 前端域名（CORS 白名单，生产必须改为实际访问域名）
WEB_ORIGIN=https://dustnote.your-domain.com

# 服务版本（必须与 package.json 一致）
SERVER_VERSION=2.5.30

# 客户端版本策略（详见 update-strategy.md §2.3）
MIN_CLIENT_VERSION=2.0.2
RECOMMENDED_CLIENT_VERSION=2.5.30
# 强制升级版本（空 = 不强制）
FORCE_UPDATE_VERSION=
# 旧 MAJOR 版本客户端 EOL 日期
EOL_DATE_FOR_V0=

# 【必填】JWT 签名密钥，≥32 字符随机串。未设置时 docker compose 会直接拒绝启动。
# 生成：openssl rand -base64 48
# 注意：配置下方 JWT_PRIVATE_KEY/JWT_PUBLIC_KEY 后，将优先使用 EdDSA（非对称签名），
# 此 JWT_SECRET 仅作为未配置非对称密钥时的回退（HS256），以及迁移期间验签旧 token。
JWT_SECRET=

# 【推荐】JWT 非对称签名（EdDSA / Ed25519）密钥对。
# 配置后优先使用 EdDSA 替代 HS256：私钥仅在服务端，泄露风险更低；公钥可离线验签。
# 生成：node server/scripts/gen-jwt-keys.js
# 留空时回退到 JWT_SECRET (HS256)。
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# 反代层数（nginx 在前面时设 1）。限流依赖它取真实客户端 IP。
TRUST_PROXY=1

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# 仅 TLS 模式：Caddy 反向代理域名
# DOMAIN=notes.your-domain.com
